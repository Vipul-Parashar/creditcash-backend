# ==============================================================================
# Credit Cash (Kredova) — Production Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` on your backend server (e.g., Hostinger VPS, Cloud Node.js, Render, Railway).
# 2. Replace all placeholder values with your real production secrets.
# 3. NEVER commit your real `.env` file to GitHub or any public repository.
# 4. NEVER upload this `.env` file into public_html or frontend static folders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Settings
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# Set APP_URL to your live website domain (no trailing slash)
# If frontend is on a subdomain: https://app.yourdomain.com
# If frontend is in a subdirectory: https://yourdomain.com/creditcash
APP_URL="https://yourdomain.com"

# Session & Security Secret (generate a secure 64-character random string)
# Linux command to generate: openssl rand -hex 32
SESSION_SECRET="REPLACE_WITH_A_RANDOM_64_CHARACTER_HEX_SECRET_FOR_PRODUCTION"

# Enforce HTTPS-only secure cookies in production
COOKIE_SECURE="true"

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Supported DB_DRIVER options:
# - "postgres" (Recommended for production): Managed PostgreSQL 15+ (e.g. Supabase, Neon, AWS RDS, Hostinger VPS)
# - "sqlite" : Uses file-based SQLite in ./data/kredova.db (Requires Node.js 22.5.0+)
DB_DRIVER="postgres"

# PostgreSQL Connection Credentials (Used when DB_DRIVER="postgres")
PGHOST="127.0.0.1"
PGPORT="5432"
PGDATABASE="kredova_production"
PGUSER="kredova_user"
PGPASSWORD="REPLACE_WITH_STRONG_PRODUCTION_DATABASE_PASSWORD"
PGSSLMODE="prefer"

# SQLite Path (Used only if DB_DRIVER="sqlite")
SQLITE_DB_PATH="./data/kredova.db"

# ------------------------------------------------------------------------------
# 3. Initial Administrator Bootstrap Account
# ------------------------------------------------------------------------------
# Used ONLY on the very first boot to create the super-admin if none exists in DB.
ADMIN_BOOTSTRAP_EMAIL="admin@yourdomain.com"
ADMIN_BOOTSTRAP_PASSWORD="REPLACE_WITH_A_VERY_STRONG_ADMIN_PASSWORD_2026!"

# ------------------------------------------------------------------------------
# 4. Official Advertising Provider Integrations (S2S Postback Verification)
# ------------------------------------------------------------------------------
# These keys are required only when activating each provider offerwall.
# Keep them blank initially if you haven't yet registered with the provider.

# 1. ayeT-Studios (https://www.ayetstudios.com)
AYET_ADSLOT_ID=""
AYET_PUBLISHER_API_KEY=""
AYET_PLACEMENT_NAME="Credit Cash Offerwall"

# 2. CPX Research (https://www.cpx-research.com)
CPX_APP_ID=""
CPX_SECURE_HASH_SECRET=""

# 3. AdGem (https://adgem.com)
ADGEM_APP_ID=""
ADGEM_POSTBACK_KEY=""
# Optional comma-separated list of allowed IP addresses from AdGem server
ADGEM_ALLOWED_IPS=""

# ------------------------------------------------------------------------------
# 5. Email (SMTP) Configuration (Optional)
# ------------------------------------------------------------------------------
# Used for member email verification and forgotten password reset links.
# Hostinger Titan Email or Google Workspace can be configured here:
SMTP_HOST="smtp.titan.email"
SMTP_PORT="587"
SMTP_USER="notifications@yourdomain.com"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM="Credit Cash <notifications@yourdomain.com>"
